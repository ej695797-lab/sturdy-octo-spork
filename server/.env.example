# Yeeps 1.31.0-blaze self-host server settings.
# start.bat / start.sh copy this to .env on first run and fill in random
# EDITOR_SECRET / EDITOR_PASSWORD. Edit .env, not this file. Never share .env.

# ── Database ────────────────────────────────────────────────────────────────
# Local MongoDB (install MongoDB Community Server) ...
MONGO_URI=mongodb+srv://sapphireunnecessary_db_user:xmcijefSg2kRp1hd@ogyeeps.ftiowhe.mongodb.net
# ... or a free MongoDB Atlas cluster: paste its connection string instead, e.g.
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?appName=Cluster0
DB_NAME=OGYeeps

# ── Network ─────────────────────────────────────────────────────────────────
PORT=8000
# The address players' headsets use for this server: exactly the "server" you
# put in the APK (tools/configure_apk.py --server). Used for news-board media,
# screens and video links. Examples:
#   http://192.168.1.20:8000          (same Wi-Fi only; your PC's LAN address)
#   https://yeeps.your-domain.com      (Cloudflare tunnel with your own domain)
PUBLIC_BASE_URL=https://yeeper920-yeeps.onrender.com

# ── Editor (web admin site at <server>/editor) ──────────────────────────────
EDITOR_PASSWORD=301212
EDITOR_SECRET=301212301212

# ── World ───────────────────────────────────────────────────────────────────
# Load the 1.31.0-blaze world (seed/world) into an empty database at startup.
SEED_WORLD=1

# ── Optional ────────────────────────────────────────────────────────────────
# Set BOT_KEY to a private random value to enable the editor's Photon bot.
# Configure the PUN app's Photon custom-auth URL to PUBLIC_BASE_URL.
BOT_KEY=
# Optional Discord profile bot. Invite with bot + applications.commands scopes.
DISCORD_BOT_TOKEN=
# Optional Discord server ID to publish slash commands there immediately.
DISCORD_GUILD_ID=
# Set this to the same PUN App ID configured in the host's APK.
# PHOTON_APP_ID=your-pun-app-id
# PHOTON_APP_VERSION=1.31.0_2.45
# PHOTON_REGION=us
# Set this to the Photon Voice App ID from the Photon dashboard for bot audio.
# YEEPS_VOICE_APP=your-photon-voice-app-id
# Discord webhooks for editor activity / in-game map edits (blank = off).
ADMIN_DISCORD_WEBHOOK=
INGAME_DISCORD_WEBHOOK=
# Link in "update your APK" / closed messages.
DISCORD_INVITE_URL=https://discord.gg/K3W6HCqS9s
# Account IDs (comma-separated) allowed to ban/warn from inside the game.
MOD_STAFF=o_25596005490046939
# Account IDs allowed to hold the "blaze" role (BLAZE blocks, saving shared maps in game).
BLAZE_HOLDERS=o_25596005490046939
# Only allow listed APK builds (off by default; a rebuilt APK changes its hashes).
ENFORCE_CLIENT_BUILD=0
# Testing: every room can switch play/creative and anyone can edit official maps in game.
UNLOCK_ALL_MODES=1
